<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinAIMagic.Documents\WinAIMagic.Documents.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="i18n\*.json" LogicalName="i18n.%(Filename).json" />
    <EmbeddedResource Include="Resources\*.json" LogicalName="Resources.%(Filename).json" />
    <!-- skills/<name>/SKILL.md and help/<language>/<NN-id>.md, read with BundledTexts -->
    <EmbeddedResource Include="Resources\skills\**\SKILL.md" LogicalName="skills/%(RecursiveDir)SKILL.md" />
    <EmbeddedResource Include="Resources\help\**\*.md" LogicalName="help/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
