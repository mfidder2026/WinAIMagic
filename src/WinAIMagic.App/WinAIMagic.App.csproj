<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RootNamespace>WinAIMagic.App</RootNamespace>
    <AssemblyName>WinAIMagic</AssemblyName>
    <UseWinUI>true</UseWinUI>
    <EnableMsixTooling>true</EnableMsixTooling>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\WinAIMagic.ico</ApplicationIcon>
    <PublishReadyToRun>false</PublishReadyToRun>
    <!-- Program.cs has the Main: the single instance is settled before anything of the UI starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.5" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets\WinAIMagic.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\WinAIMagic.Core\WinAIMagic.Core.csproj" />
    <ProjectReference Include="..\WinAIMagic.Engine\WinAIMagic.Engine.csproj" />
    <ProjectReference Include="..\WinAIMagic.Chat\WinAIMagic.Chat.csproj" />
    <ProjectReference Include="..\WinAIMagic.Studio\WinAIMagic.Studio.csproj" />
  </ItemGroup>
</Project>
