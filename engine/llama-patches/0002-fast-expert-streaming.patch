+namespace {
+
+// one large read for the chunk instead of a page fault per page, then the copy if there is a destination
+void llama_upload_chunk(const llama_tensor_upload & u) {
+#if defined(_POSIX_MAPPED_FILES)
+    static const uintptr_t page_size = sysconf(_SC_PAGESIZE);
+    const uintptr_t first = (uintptr_t) u.src / page_size * page_size;
+    posix_madvise((void *) first, (uintptr_t) u.src + u.size - first, POSIX_MADV_WILLNEED);
+#endif
+    if (u.dst) {
+        ggml_backend_tensor_set(u.dst, u.src, u.offset, u.size);
+    }
+}
+
+// 1 MiB chunks keep all threads busy, also when only a few experts are missing
+void llama_upload_split(const llama_tensor_upload & u, std::vector<llama_tensor_upload> & out) {
+    constexpr size_t chunk_size = 1024*1024;
+    for (size_t done = 0; done < u.size; done += chunk_size) {
+        out.push_back({ u.dst, u.offset + done, (const uint8_t *) u.src + done, std::min(chunk_size, u.size - done) });
+    }
+}
+
+// the threads of llama_upload_parallel, started on first use and kept for the life of the process
+struct llama_upload_pool {
+    std::mutex mutex;
+    std::condition_variable cv_work;
+    std::condition_variable cv_done;
+
+    // the tasks of the current run, the caller waits for them
+    const std::function<void(size_t)> * task = nullptr;
+    size_t n_tasks = 0;
+    size_t n_next  = 0;
+    size_t n_done  = 0;
+
+    // read ahead when there are no tasks, nobody waits for it
+    std::vector<llama_tensor_upload> ahead;
+    size_t n_ahead_next = 0;
+
+    std::mutex mutex_run; // one run at a time
+    size_t n_threads = 0;
+
+    llama_upload_pool() {
+        n_threads = std::clamp((int) std::thread::hardware_concurrency(), 4, 16);
+        for (size_t i = 0; i < n_threads; ++i) {
+            std::thread([this] { work(); }).detach();
+        }
+    }
+
+    [[noreturn]] void work() {
+        std::unique_lock<std::mutex> lock(mutex);
+        while (true) {
+            cv_work.wait(lock, [this] { return n_next < n_tasks || n_ahead_next < ahead.size(); });
+            if (n_next < n_tasks) {
+                const size_t i = n_next++;
+                const auto * fn = task;
+                lock.unlock();
+                (*fn)(i);
+                lock.lock();
+                if (++n_done == n_tasks) {
+                    cv_done.notify_all();
+                }
+            } else {
+                const llama_tensor_upload chunk = ahead[n_ahead_next++];
+                lock.unlock();
+                llama_upload_chunk(chunk);
+                lock.lock();
+            }
+        }
+    }
+
+    // fn(0) .. fn(n - 1) on the threads, returns when all are done
+    void run(size_t n, const std::function<void(size_t)> & fn) {
+        if (n == 0) {
+            return;
+        }
+        std::lock_guard<std::mutex> lock_run(mutex_run);
+        std::unique_lock<std::mutex> lock(mutex);
+        // reads ahead that have not started are dropped, they would take the disk from the reads that are needed now
+        ahead.clear();
+        n_ahead_next = 0;
+        task    = &fn;
+        n_tasks = n;
+        n_next  = 0;
+        n_done  = 0;
+        cv_work.notify_all();
+        cv_done.wait(lock, [this] { return n_done == n_tasks; });
+        task    = nullptr;
+        n_tasks = 0;
+        n_next  = 0;
+        n_done  = 0;
+    }
+
+    void read_ahead(const llama_memory_ranges & ranges) {
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            ahead.clear();
+            n_ahead_next = 0;
+            for (const auto & r : ranges) {
+                llama_upload_split({ nullptr, 0, r.addr, r.size }, ahead);
+            }
+        }
+        cv_work.notify_all();
+    }
+
+    // only for devices that can map host memory (CPU, Metal) a tensor set is a memcpy that several threads can do at once
+    std::mutex mutex_props;
+    std::unordered_map<ggml_backend_buffer_type_t, bool> parallel_set;
+
+    bool can_set_in_parallel(const ggml_tensor * t) {
+        ggml_backend_buffer_t buf = t->view_src ? t->view_src->buffer : t->buffer;
+        if (buf == nullptr) {
+            return false;
+        }
+        ggml_backend_buffer_type_t buft = ggml_backend_buffer_get_type(buf);
+        std::lock_guard<std::mutex> lock(mutex_props);
+        auto it = parallel_set.find(buft);
+        if (it == parallel_set.end()) {
+            ggml_backend_dev_t dev = ggml_backend_buft_get_device(buft);
+            ggml_backend_dev_props props;
+            if (dev != nullptr) {
+                ggml_backend_dev_get_props(dev, &props);
+            }
+            it = parallel_set.emplace(buft, dev != nullptr && props.caps.buffer_from_host_ptr).first;
+        }
+        return it->second;
+    }
+};
+
+llama_upload_pool & llama_upload_pool_get() {
+    static llama_upload_pool * pool = new llama_upload_pool();
+    return *pool;
+}
+
+}
+
+void llama_upload_parallel(const std::vector<llama_tensor_upload> & uploads) {
+    if (uploads.empty()) {
+        return;
+    }
+    auto & pool = llama_upload_pool_get();
+
+    // other devices only get their source pages read in parallel, the copies are done after that on this thread
+    std::vector<llama_tensor_upload> chunks;
+    std::vector<llama_tensor_upload> serial;
+    for (const auto & u : uploads) {
+        if (u.dst != nullptr && !pool.can_set_in_parallel(u.dst)) {
+            serial.push_back(u);
+            llama_upload_split({ nullptr, 0, u.src, u.size }, chunks);
+        } else {
+            llama_upload_split(u, chunks);
+        }
+    }
+    pool.run(chunks.size(), [&](size_t i) { llama_upload_chunk(chunks[i]); });
+    for (const auto & u : serial) {
+        ggml_backend_tensor_set(u.dst, u.src, u.offset, u.size);
+    }
+}
+
+void llama_read_ahead(const llama_memory_ranges & ranges) {
+    llama_upload_pool_get().read_ahead(ranges);
+}
+
 size_t llama_path_max() {
     return PATH_MAX;
 }
