+void llm_graph_context::build_moe_cache_guess(
+         ggml_tensor * cur,
+        llama_expert_gating_func_type gating_op,
+                 int   il) const {
+    if (moe_cache == nullptr) {
+        return;
+    }
+    const llama_moe_cache::router * next = moe_cache->get_next_router(il, cur->ne[1]);
+    if (next == nullptr) {
+        moe_cache->set_guess(il, nullptr);
+        return;
+    }
+
+    // the router of the next layer on the input of this layer, the residual stream changes little from layer to layer
+    ggml_tensor * probs = build_lora_mm(next->gate_inp, cur); // [n_expert, n_tokens]
+    if (next->exp_probs_b != nullptr) {
+        // the selection bias is added to the gated scores
+        switch (gating_op) {
+            case LLAMA_EXPERT_GATING_FUNC_TYPE_SIGMOID:       probs = ggml_sigmoid(ctx0, probs); break;
+            case LLAMA_EXPERT_GATING_FUNC_TYPE_SQRT_SOFTPLUS: probs = ggml_sqrt(ctx0, ggml_softplus(ctx0, probs)); break;
+            default: break;
+        }
+        probs = ggml_add(ctx0, probs, next->exp_probs_b);
+    }
+    // top_k is a view into the sorted experts, the host reads a contiguous copy
+    ggml_tensor * guess = ggml_cont(ctx0, ggml_argsort_top_k(ctx0, probs, next->n_guess)); // [n_guess, n_tokens]
+    cb(guess, "ffn_moe_guess", il);
+
+    // the cache reads the guess on the host when it uploads the experts of this layer
+    ggml_set_output(guess);
+    ggml_build_forward_expand(gf, guess);
+    moe_cache->set_guess(il, guess);
+}
